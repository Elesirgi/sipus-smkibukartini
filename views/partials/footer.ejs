<footer class="site-footer">
  <div class="wrap footer-inner">
    <div class="footer-brand">
      <span class="brand-mark" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M4 5.5C4 4.67 4.67 4 5.5 4H11V19H5.5C4.67 19 4 18.33 4 17.5V5.5Z" fill="currentColor" opacity=".55"/>
          <path d="M20 5.5C20 4.67 19.33 4 18.5 4H13V19H18.5C19.33 19 20 18.33 20 17.5V5.5Z" fill="currentColor"/>
        </svg>
      </span>
      <p><%= site.libraryFullName %><br><%= site.address %></p>
    </div>
    <div class="footer-links">
      <h4>Tautan</h4>
      <a href="/dashboard">Beranda</a>
      <a href="/katalog">Katalog Buku</a>
      <a href="/kategori">Kategori</a>
      <a href="/anggota">Anggota</a>
      <a href="/peminjaman">Peminjaman</a>
      <a href="/admin/login">Login Admin</a>
    </div>
    <div class="footer-contact">
      <h4>Jam Layanan</h4>
      <p class="footer-plain"><%= site.openHours %></p>
      <a href="mailto:<%= site.email %>"><%= site.email %></a>
      <a href="<%= site.whatsappLink %>" target="_blank" rel="noopener"><%= site.phoneDisplay %></a>
    </div>
    <div class="footer-social">
      <h4>Media Sosial</h4>
      <div class="social-row">
        <a href="<%= site.instagram %>" target="_blank" rel="noopener" aria-label="Instagram">IG</a>
      </div>
    </div>
  </div>
  <div class="footer-bottom">
    <p>&copy; <%= new Date().getFullYear() %> <%= site.libraryName %> — <%= site.schoolName %>. Sistem ini adalah proyek pengembangan non-resmi.</p>
  </div>
</footer>

<button class="to-top" id="toTop" aria-label="Kembali ke atas">↑</button>

<script src="/js/script.js"></script>
