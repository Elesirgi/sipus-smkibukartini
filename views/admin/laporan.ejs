<!DOCTYPE html><html lang="id"><head><%- include('../partials/head') %></head><body>
<%- include('../partials/header') %>
<section class="section page-hero no-print"><div class="wrap"><div class="page-heading-row"><div><p class="eyebrow">Administrasi</p><h1 class="section-title">Laporan Perpustakaan</h1><p>Ringkasan koleksi, anggota, sirkulasi, dan denda.</p></div><div class="page-heading-actions"><a class="btn btn-ghost" href="/admin/audit">Audit</a><a class="btn btn-ghost" href="/admin/backup">Backup JSON</a><a class="btn btn-ghost" href="/admin/backup/restore">Restore</a><a class="btn btn-ghost" href="/admin/laporan/csv">Unduh CSV</a><button class="btn btn-primary" onclick="window.print()">Cetak / Simpan PDF</button></div></div></div></section>
<section class="section no-print"><div class="wrap"><form class="admin-form compact-filter" method="GET" action="/admin/laporan"><div class="form-grid"><label class="form-field"><span>Dari</span><input type="date" name="from" value="<%= filters?.from||'' %>"></label><label class="form-field"><span>Sampai</span><input type="date" name="to" value="<%= filters?.to||'' %>"></label><label class="form-field"><span>Status</span><select name="status"><option value="">Semua</option><option value="dipinjam" <%= filters?.status==='dipinjam'?'selected':'' %>>Dipinjam</option><option value="terlambat" <%= filters?.status==='terlambat'?'selected':'' %>>Terlambat</option><option value="dikembalikan" <%= filters?.status==='dikembalikan'?'selected':'' %>>Dikembalikan</option></select></label><label class="form-field"><span>Kategori</span><select name="category"><option value="">Semua</option><% categories.forEach(function(c){ %><option value="<%= c.slug %>" <%= filters?.category===c.slug?'selected':'' %>><%= c.name %></option><% }) %></select></label></div><button class="btn btn-primary">Terapkan Filter</button></form></div></section>
<section class="section report-section"><div class="wrap">
<div class="report-header"><div><h2><%= site.libraryFullName %></h2><p>Dicetak: <%= formatDateID(new Date().toISOString()) %></p></div><span class="report-badge">LAPORAN</span></div>
<div class="report-stat-grid"><div><b><%= stats.totalTitles %></b><span>Judul</span></div><div><b><%= stats.totalCopies %></b><span>Eksemplar</span></div><div><b><%= stats.totalMembers %></b><span>Anggota</span></div><div><b><%= stats.activeLoans %></b><span>Pinjaman aktif</span></div><div class="danger"><b><%= stats.overdueLoans %></b><span>Terlambat</span></div><div><b>Rp <%= stats.totalFines.toLocaleString('id-ID') %></b><span>Denda terhitung</span></div></div>
<div class="report-columns">
<section><h3>Rekap Kategori</h3><table class="report-table"><thead><tr><th>Kategori</th><th>Judul</th><th>Eksemplar</th></tr></thead><tbody><% byCategory.forEach(c=>{ %><tr><td><%= c.name %></td><td><%= c.titles %></td><td><%= c.copies %></td></tr><% }) %></tbody></table></section>
<section><h3>Buku Paling Sering Dipinjam</h3><table class="report-table"><thead><tr><th>Buku</th><th>Jumlah</th></tr></thead><tbody><% popularBooks.forEach(b=>{ %><tr><td><%= b.title %></td><td><%= b.loanCount %>×</td></tr><% }) %></tbody></table></section>
</div>
<p class="report-note">Denda dihitung otomatis sebesar Rp <%= finePerDay.toLocaleString('id-ID') %>/hari untuk keterlambatan. Daftar keterlambatan tersedia pada menu Peminjaman Terlambat.</p>
</div></section><%- include('../partials/footer') %></body></html>
