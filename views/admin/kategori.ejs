<!DOCTYPE html>
<html lang="id"><head><%- include('../partials/head') %></head><body class="admin-page"><%- include('../partials/header') %>
<main><section class="section page-hero"><div class="wrap admin-page-title"><div><p class="eyebrow">Panel Admin</p><h1 class="section-title">Kelola Kategori</h1><p>Tambahkan kategori baru untuk mengelompokkan koleksi buku sekolah.</p></div><a class="btn btn-ghost" href="/admin">← Panel Admin</a></div></section>
<section class="section"><div class="wrap admin-category-layout">
<div class="admin-form-wrap"><form class="admin-form" action="/admin/kategori/tambah" method="POST"><div class="admin-form-heading"><p class="eyebrow">Kategori Baru</p><h2>Tambah Kategori</h2></div><% if(error){ %><div class="form-error"><%= error %></div><% } %><label class="form-field form-field-wide"><span>Nama Kategori</span><input name="name" required placeholder="Contoh: Matematika"></label><label class="form-field form-field-wide"><span>Deskripsi</span><textarea name="description" rows="4" placeholder="Opsional"></textarea></label><button class="btn btn-primary" type="submit">Tambah Kategori</button></form></div>
<div class="category-admin-list"><div class="admin-form-heading"><p class="eyebrow">Daftar</p><h2>Kategori Tersedia</h2></div><% categories.forEach(c=>{ %><div class="category-admin-row"><div><strong><%= c.name %></strong><small><%= c.description||'Tidak ada deskripsi' %></small></div><form action="/admin/kategori/<%= c.slug %>/hapus" method="POST" onsubmit="return confirm('Hapus kategori ini?')"><button class="btn-delete" type="submit">Hapus</button></form></div><% }) %></div>
</div></section></main><%- include('../partials/footer') %></body></html>
