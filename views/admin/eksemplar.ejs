<!DOCTYPE html><html lang="id"><head><%- include('../partials/head') %></head><body><%- include('../partials/header') %>
<section class="section page-hero"><div class="wrap"><p class="eyebrow">Inventaris</p><h1 class="section-title">Eksemplar Buku</h1><p><%= book.title %></p></div></section>
<section class="section"><div class="wrap">
<% if(message){ %><div class="form-success"><%= message %></div><% } %><% if(error){ %><div class="form-error"><%= error %></div><% } %>
<div class="section-heading-row"><div><p class="result-count"><strong><%= copies.length %></strong> eksemplar terdaftar • <%= book.availableCopies %> tersedia • <%= book.totalCopies - book.availableCopies %> dipinjam/tidak tersedia</p></div><a class="btn btn-ghost" href="/admin/buku">Kembali</a></div>
<div class="admin-form" style="margin-bottom:24px"><div class="admin-form-section-title">Atur Jumlah Eksemplar</div><form method="POST" action="/admin/buku/<%= encodeURIComponent(book.id) %>/eksemplar/jumlah" class="inline-form"><label class="form-field" style="min-width:260px"><span>Total Eksemplar</span><input type="number" name="totalCopies" min="1" max="1000" value="<%= book.totalCopies %>" required></label><button class="btn btn-primary" type="submit">Simpan Jumlah</button></form><p class="form-note">Admin dapat menaikkan atau menurunkan jumlah. Eksemplar yang sedang dipinjam, hilang, atau rusak berat tidak akan dihapus secara paksa.</p></div><div class="loan-table-wrap"><table class="loan-table"><thead><tr><th>Kode</th><th>Status</th><th>Kondisi</th><th>Rak</th><th>Aksi</th></tr></thead><tbody><% copies.forEach(c=>{ %><tr><td><span class="inventory-code"><%= c.id %></span><span class="barcode-mini" data-code="<%= c.id %>"></span></td><td><span class="status-badge status-<%= c.status==='dipinjam'?'dipinjam':'dikembalikan' %>"><%= c.status %></span></td><td><%= c.condition %></td><td><%= c.shelfLocation %></td><td><form action="/admin/eksemplar/<%= c.id %>/kondisi" method="POST" class="inline-form"><select name="condition"><option value="baik" <%= c.condition==='baik'?'selected':'' %>>Baik</option><option value="rusak ringan" <%= c.condition==='rusak ringan'?'selected':'' %>>Rusak Ringan</option><option value="rusak berat" <%= c.condition==='rusak berat'?'selected':'' %>>Rusak Berat</option><option value="hilang" <%= c.condition==='hilang'?'selected':'' %>>Hilang</option></select><button class="btn btn-ghost btn-sm">Simpan</button></form></td></tr><% }) %></tbody></table></div></div></section><%- include('../partials/footer') %></body></html>
