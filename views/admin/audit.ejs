<!DOCTYPE html><html lang="id"><head><%- include('../partials/head') %></head><body><%- include('../partials/header') %><section class="section page-hero"><div class="wrap"><p class="eyebrow">Keamanan</p><h1 class="section-title">Audit Log</h1><p>Catatan aktivitas administrasi dan sirkulasi terbaru.</p></div></section><section class="section"><div class="wrap"><div class="loan-table-wrap"><table class="loan-table"><thead><tr><th>Waktu</th><th>Pengguna</th><th>Aksi</th><th>Detail</th></tr></thead><tbody><% logs.forEach(l=>{ %><tr><td><%= formatDateID(l.at) %></td><td><strong><%= l.username %></strong><small class="table-sub"><%= l.role %></small></td><td><%= l.action %></td><td><%= l.detail %></td></tr><% }) %></tbody></table></div></div></section><%- include('../partials/footer') %></body></html>
