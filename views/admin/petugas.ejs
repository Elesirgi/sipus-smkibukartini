<!DOCTYPE html><html lang="id"><head><%- include('../partials/head') %></head><body><%- include('../partials/header') %>
<section class="section page-hero"><div class="wrap"><p class="eyebrow">Akses Sistem</p><h1 class="section-title">Admin & Petugas</h1><p>Kelola akun staf yang boleh mengakses fitur inventaris dan sirkulasi.</p></div></section>
<section class="section"><div class="wrap staff-grid"><div class="admin-form-wrap"><form class="admin-form" action="/admin/petugas/tambah" method="POST"><h2>Tambah Petugas</h2><% if(error){ %><div class="form-error"><%= error %></div><% } %><div class="form-grid"><label class="form-field"><span>Nama</span><input name="name" required></label><label class="form-field"><span>Username</span><input name="username" required pattern="[a-z0-9._-]{3,32}"></label><label class="form-field password-field"><span>Password</span><div class="password-input-wrap"><input type="password" name="password" minlength="6" required><button type="button" class="password-toggle" aria-label="Tampilkan password" aria-pressed="false">Lihat</button></div></label><input type="hidden" name="role" value="petugas"><label class="form-field"><span>Peran</span><input value="Petugas" readonly></label></div><button class="btn btn-primary" type="submit">Buat Akun Petugas</button></form></div><div><div class="staff-list">
<% users.forEach(u=>{ %><div class="staff-card"><div class="member-avatar"><%= u.name.charAt(0) %></div><div><strong><%= u.name %></strong><span>@<%= u.username %></span></div><b class="role-pill role-<%= u.role %>"><%= u.role %></b><span class="status-dot <%= u.active ? 'is-active':'is-inactive' %>"><%= u.active ? 'Aktif':'Nonaktif' %></span><% if(u.username!=='admin'){ %><form action="/admin/petugas/<%= encodeURIComponent(u.username) %>/status" method="POST"><input type="hidden" name="active" value="<%= u.active?'false':'true' %>"><button class="btn-edit"><%= u.active?'Nonaktifkan':'Aktifkan' %></button></form><form action="/admin/petugas/<%= encodeURIComponent(u.username) %>/reset" method="POST" class="inline-form"><div class="password-input-wrap"><input type="password" name="password" minlength="6" placeholder="Password baru" required><button type="button" class="password-toggle" aria-label="Tampilkan password" aria-pressed="false">Lihat</button></div><button class="btn-edit">Reset</button></form><% } %></div><% }) %></div></div></div></section><%- include('../partials/footer') %></body></html>