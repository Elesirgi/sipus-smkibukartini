<!DOCTYPE html><html lang="id"><head><%- include('partials/head') %></head><body><%- include('partials/header') %>
<section class="hero-sipus"><div class="wrap hero-inner"><p class="eyebrow eyebrow-on-dark">Portal Anggota</p><h1>Halo, <em><%= member?.name || user.name %></em></h1><p class="lead-on-dark">Pantau buku yang sedang kamu pinjam, jatuh tempo, dan riwayat aktivitas perpustakaan.</p><div class="hero-actions"><a class="btn btn-primary" href="/katalog">Cari Buku</a><a class="btn btn-ghost-on-dark" href="/profil">Profil Saya</a></div></div></section>
<section class="section"><div class="wrap"><div class="member-notice">Periksa <a href="/peminjaman">peminjaman saya</a> secara berkala. Buku yang melewati jatuh tempo akan otomatis masuk status terlambat dan dihitung dendanya.</div><div class="section-heading-row"><div><p class="eyebrow">Pinjaman Saya</p><h2 class="section-title">Aktivitas terbaru</h2></div><a class="btn btn-ghost" href="/peminjaman">Lihat riwayat →</a></div>
<% if(!myLoans.length){ %><div class="empty-card">Belum ada riwayat peminjaman.</div><% } else { %><div class="member-loan-grid"><% myLoans.slice(0,6).forEach(function(l){ %><article class="member-loan-card"><div><span class="status-badge status-<%= l.status %>"><%= l.status %></span><h3><%= l.book?.title || 'Buku' %></h3><p><%= l.copy?.id || 'Eksemplar' %> · Jatuh tempo <%= formatDateID(l.dueDate) %></p></div><div class="member-loan-meta"><strong><%= l.status==='dikembalikan' ? formatDateID(l.returnDate) : (l.overdueDays ? l.overdueDays+' hari terlambat' : 'Masih dipinjam') %></strong><span>Rp <%= l.fine.toLocaleString('id-ID') %></span></div></article><% }) %></div><% } %></div></section>
<section class="section section-tinted"><div class="wrap"><div class="section-heading-row"><div><p class="eyebrow">Rekomendasi</p><h2 class="section-title">Koleksi untuk dipelajari</h2></div><a href="/katalog" class="text-link">Buka katalog →</a></div><div class="book-grid"><% books.forEach(function(b){ %><a class="book-card" href="/katalog/<%= encodeURIComponent(b.slug || b.id) %>"><div class="book-cover book-cover-<%= b.category %>"><img class="book-cover-image" src="/book-cover/<%= encodeURIComponent(b.id) %>" alt="Cover <%= b.title %>" loading="lazy"><div class="book-cover-fallback"><span class="book-cover-mini-label">SIPUS</span><span class="book-cover-title"><%= b.title %></span></div></div><div class="book-card-body"><span class="book-card-category"><%= b.subject||b.category %></span><h3><%= b.title %></h3><p class="book-card-author"><%= b.author %></p></div></a><% }) %></div></div></section>
<%- include('partials/footer') %></body></html>
