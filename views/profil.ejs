<!DOCTYPE html><html lang="id"><head><%- include('partials/head') %></head><body><%- include('partials/header') %>
<section class="section page-hero"><div class="wrap member-detail-header"><div class="member-avatar member-avatar-lg"><%= member.name.charAt(0) %></div><div><p class="eyebrow">Profil Anggota</p><h1 class="section-title"><%= member.name %></h1><p class="member-since"><%= member.role %> · <%= member.kelas %> · ID <%= member.id %></p></div></div></section>
<section class="section"><div class="wrap"><div class="profile-grid"><div class="profile-card"><h2>Data Saya</h2><dl><dt>Nama</dt><dd><%= member.name %></dd><dt>Status</dt><dd><%= member.role %></dd><dt>Kelas / Bagian</dt><dd><%= member.kelas %></dd><dt>NISN</dt><dd><%= member.nisn || '-' %></dd><dt>Email</dt><dd><%= member.email || '-' %></dd><dt>No. Telepon</dt><dd><%= member.phone || '-' %></dd><dt>Terdaftar</dt><dd><%= formatDateID(member.memberSince) %></dd></dl></div><div class="profile-card"><h2>Ringkasan</h2><div class="profile-stat"><strong><%= loans.filter(l=>l.status!=='dikembalikan').length %></strong><span>pinjaman aktif</span></div><div class="profile-stat"><strong><%= loans.filter(l=>l.status==='terlambat').length %></strong><span>terlambat</span></div><div class="profile-stat"><strong>Rp <%= loans.reduce((s,l)=>s+l.fine,0).toLocaleString('id-ID') %></strong><span>denda terhitung</span></div><a class="btn btn-primary" href="/peminjaman">Lihat Semua Peminjaman</a></div></div></div></section><%- include('partials/footer') %></body></html>
