<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <title>Edit Buku - SIPUS</title>
</head>
<body>
  <div class="container">
    <h1>Edit Buku</h1>
    <form>
      <div class="form-group">
        <label>Judul Buku</label>
        <input type="text" value="<%= book.title %>">
      </div>
      <div class="form-group">
        <label>Penulis</label>
        <input type="text" value="<%= book.author %>">
      </div>
      <a href="/books" class="btn-back">← Kembali ke Katalog</a>
    </form>
  </div>
</body>
</html>
